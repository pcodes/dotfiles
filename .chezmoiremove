# Targets deleted from $HOME that other machines must also clean up. Chezmoi
# acts on this at the next apply; drop an entry once every machine has caught up.
#
# .profile is a rustup-init leftover. zsh never reads it outside sh-emulation
# mode, the login shell here is zsh, and there is no bash_profile or bashrc, so
# nothing on these machines sourced it. What it did -- source ~/.cargo/env --
# .zshenv already does, guarded on the file existing.
#
# .zsh_completions held one stale _chezmoi.zsh. The directory was never on
# fpath, and compinit would not have loaded that filename anyway; it wants
# `_chezmoi`, which Homebrew's chezmoi formula already installs into
# $HOMEBREW_PREFIX/share/zsh/site-functions.
.profile
.zsh_completions

# Unlike the entries above, this block is permanent. A machine that answered no
# to `personal` loses the Claude config it was given before. Exact paths only:
# the rest of ~/.claude is Claude Code's own (settings.json, transcripts). A
# machine with no answer yet keeps what it has.
{{ if and (hasKey . "personal") (not .personal) }}
.claude/CLAUDE.md
.claude/.i-have-adhd-always
.claude/statusline-command.sh
.claude/skills
{{ end }}
