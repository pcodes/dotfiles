CLAUDE.md

# .zprofile exists only to repair the PATH ordering that macOS's path_helper
# undoes. No other platform runs path_helper, so nothing to repair there.
{{ if ne .chezmoi.os "darwin" }}
.zprofile
{{ end }}

# Desktop entries are a Linux launcher concept; macOS takes kitty's icon from
# kitty.app.png alone. Ignored as a whole directory: ignoring only the file still
# leaves chezmoi creating an empty applications/ on macOS.
{{ if eq .chezmoi.os "darwin" }}
.local/share/applications
{{ end }}

# ~/.claude is for personal machines only (`personal` in .chezmoi.toml.tmpl).
# A config with no `personal` key counts as not personal.
# The 1Password agent.toml is too: it replaces the agent's default vault list,
# so on the work Mac it would stop serving keys from the work account.
{{ if not (dig "personal" false .) }}
.claude
.config/1Password
{{ end }}
