{{- $hostkey := .chezmoi.hostname -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $hostkey = output "scutil" "--get" "LocalHostName" | trim -}}
{{- end -}}
### ZSH CONFIG OPTIONS ###
# Everything in this section must be set *before* initializing Oh My ZSH

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Set ZSH settings
export ZSH="$HOME/.oh-my-zsh"
export ZSH_CUSTOM="$HOME/.oh-my-zsh/custom"

# Set ZSH theme- Powerlevel10k if installed, otherwise fallback to a default
if [[ -d "${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/themes/powerlevel10k" ]]; then
    ZSH_THEME="powerlevel10k/powerlevel10k"
else
    ZSH_THEME="robbyrussell"
fi

# PATH, EDITOR, LANG and GOPATH live in ~/.zshenv, which every zsh reads --
# .zshrc is skipped entirely by scripts, cron and ssh commands. The ordering is
# then repaired in ~/.zprofile, because macOS's path_helper demotes it.

# OMZ plugin setup. The package-manager and docker plugins are gated on the
# platform they apply to -- each one adds completions and aliases for a tool that
# isn't present elsewhere.
#
# zsh-syntax-highlighting is deliberately not in this list; it is sourced at the
# bottom of this file instead, where its load order is guaranteed.
plugins=(
    git
    zsh-autosuggestions
    autoupdate
{{- if eq .chezmoi.os "linux" }}
{{-   $id := dig "id" "" .chezmoi.osRelease }}
{{-   $like := dig "idLike" "" .chezmoi.osRelease }}
    docker
{{-   if or (eq $id "arch") (contains "arch" $like) }}
    archlinux
{{-   end }}
{{-   if or (has $id (list "fedora" "rhel" "centos" "rocky" "almalinux")) (contains "fedora" $like) (contains "rhel" $like) }}
    dnf
{{-   end }}
{{- end }}
)

source $ZSH/oh-my-zsh.sh

chezmoi-cd() {
    cd $(chezmoi source-path)
}

### OTHER ZSH SETTINGS ###
# Optional tools are guarded with `(( $+commands[x] ))` throughout this file.
# $commands is zsh's PATH lookup table, so the test means "this binary is
# installed" and nothing else. `type` and `command -v` also match shell
# functions and aliases -- including the aliases below, so `type cat` succeeds
# whether or not bat exists -- which makes them useless for this.

# Set auto-complete shortcut to ctrl-space
bindkey '^ ' autosuggest-accept

# If 1password CLI is installed, add completions
if (( $+commands[op] )); then
    eval "$(op completion zsh)"; compdef _op op
fi

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# Set up fzf key bindings and fuzzy completion
(( $+commands[fzf] )) && source <(fzf --zsh)

### ALIASES ###
# Set bash aliases. These will override anything from OMZ plugins

alias edit="chezmoi edit"
alias cz='chezmoi'
alias czcd='chezmoi-cd'

(( $+commands[nvim] )) && alias vim="nvim"
(( $+commands[bat] ))  && alias cat="bat"

if (( $+commands[lsd] )); then
    alias ls="lsd"
    alias l='ls -l'
    alias la='ls -a'
    alias lla='ls -la'
    alias lt='ls --tree'
fi

### MACHINE CONFIG ###
# Both files load after the aliases above, so either can override them. That is
# why they are here and not before Oh My Zsh, where nothing they set could win
# against what this file defines afterwards.
#
#   ~/.config/zsh/hosts/{{ $hostkey }}.zsh -- this machine, tracked in git
#   ~/.zshrc.local -- this machine, never committed
#
# Per-OS settings want neither file. This is a chezmoi template, so they go
# inline behind an `eq .chezmoi.os` guard, the way the plugin list above does.
{{ if eq .chezmoi.os "darwin" }}
# The host key is LocalHostName, not `hostname`. `hostname` follows DHCP -- this
# machine answers to both Pats-Air and Pats-MacBook-Air depending on the network
# -- so a file keyed on it would load only on some networks. It is resolved at
# `chezmoi apply` time, so renaming the machine needs an apply to take effect.
{{ end -}}
zsh_host_config=${XDG_CONFIG_HOME:-$HOME/.config}/zsh/hosts/{{ $hostkey }}.zsh
[[ -f $zsh_host_config ]] && source $zsh_host_config
unset zsh_host_config

[[ -f $HOME/.zshrc.local ]] && source $HOME/.zshrc.local

### SYNTAX HIGHLIGHTING ###
# Keep this last, and after the fzf setup above.
#
# On zsh 5.9+ this is belt and braces: z-sy-h hooks zle-line-pre-redraw via
# add-zle-hook-widget, which fires on every redraw no matter what loaded when.
# Below 5.9, or wherever add-zle-hook-widget is missing, it falls back to
# wrapping each widget individually at source time -- and then it only wraps
# what already exists, leaving anything bound later (fzf's ctrl-r and ctrl-t,
# widgets from OMZ plugins) unhighlighted. Sourcing last is correct on both
# paths, so this file does not need to care which one a given machine takes.

zsh_syntax_highlighting=$ZSH_CUSTOM/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
[[ -f $zsh_syntax_highlighting ]] && source $zsh_syntax_highlighting
unset zsh_syntax_highlighting

