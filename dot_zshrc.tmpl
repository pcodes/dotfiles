### ZSH CONFIG OPTIONS ###
# Everything in this section must be set *before* initializing Oh My ZSH

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Set ZSH settings
export ZSH="$HOME/.oh-my-zsh"
export ZSH_CUSTOM="$HOME/.oh-my-zsh/custom"

# Set ZSH theme- Powerlevel10k if installed, otherwise fallback to a default
if [[ -d "${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/themes/powerlevel10k" ]]; then
    ZSH_THEME="powerlevel10k/powerlevel10k"
else
    ZSH_THEME="robbyrussell"
fi

# PATH, EDITOR, LANG and GOPATH live in ~/.zshenv, which every zsh reads --
# .zshrc is skipped entirely by scripts, cron and ssh commands. The ordering is
# then repaired in ~/.zprofile, because macOS's path_helper demotes it.

# OMZ plugin setup. The package-manager and docker plugins are gated on the
# platform they apply to -- each one adds completions and aliases for a tool that
# isn't present elsewhere.
plugins=(
    git
    zsh-autosuggestions
    zsh-syntax-highlighting
    autoupdate
{{- if eq .chezmoi.os "linux" }}
{{-   $id := dig "id" "" .chezmoi.osRelease }}
{{-   $like := dig "idLike" "" .chezmoi.osRelease }}
    docker
{{-   if or (eq $id "arch") (contains "arch" $like) }}
    archlinux
{{-   end }}
{{-   if or (has $id (list "fedora" "rhel" "centos" "rocky" "almalinux")) (contains "fedora" $like) (contains "rhel" $like) }}
    dnf
{{-   end }}
{{- end }}
)

# Source the local zshrc before OMZ in case there are OMZ-specific settings
[[ -f $HOME/.zshrc.local ]] && source $HOME/.zshrc.local

source $ZSH/oh-my-zsh.sh

chezmoi-cd() {
    cd $(chezmoi source-path)
}

### PROGRAM DETECTION ###
# This section sets vars for various replacement programs like nvim and lsd

if type "nvim" >/dev/null; then
    HAS_NVIM=true
fi

if type "lsd" >/dev/null; then
    HAS_LSD=true
fi

if type "bat" >/dev/null; then
    HAS_BAT=true
fi

if type "op" >/dev/null; then
    HAS_OP=true
fi

### OTHER ZSH SETTINGS ###

# Set auto-complete shortcut to ctrl-space
bindkey '^ ' autosuggest-accept

# If 1password CLI is installed, add completions
if [[ -n $HAS_OP ]]; then
    eval "$(op completion zsh)"; compdef _op op
fi

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# Set up fzf key bindings and fuzzy completion
(( $+commands[fzf] )) && source <(fzf --zsh)

### ALIASES ###
# Set bash aliases. These will override anything from OMZ plugins

alias edit="chezmoi edit"
alias cz='chezmoi'
alias czcd='chezmoi-cd'

if [[ ! -z $HAS_NVIM ]]; then
    alias vim="nvim"
fi

if [[ ! -z $HAS_BAT ]]; then
    alias cat="bat"
fi

if [[ -n $HAS_LSD ]]; then
    alias ls="lsd"
    alias l='ls -l'
    alias la='ls -a'
    alias lla='ls -la'
    alias lt='ls --tree'
fi

